C RCU-txn+publish

(*
 * Result: Never
 *
 * A transaction publishes a new object, end to end.  The writer builds the
 * object, initializes the record, installs the proxy, flips the selector and
 * settles the slot.  A reader that finds the proxy reads the record
 * initialized.  A reader that reaches the object reads it built.  It may
 * reach the object through the proxy, or in the slot once settled.
 *
 * Slot a switches from NULL to the new object n.  The writer builds n by
 * storing 1 to it.  The record is rg, ro and rn (see RCU-txn+install).
 * Before the writer runs, they hold garbage: junk, or 2 for the selector.
 *
 * The object is built before the install.  The install's store-release orders
 * the object for a reader that finds the proxy.  So this outcome stays
 * forbidden even without the flip's store-release.  The flip's store-release
 * orders the installs of a transaction before its selector.  This matters for
 * a reader that resolves several slots of the transaction: see
 * RCU-txn+monotonic+dep+once-flip.
 *)

{
int junk = 9;
int sel = 2;
int *rg = &junk;
int *ro = &junk;
int *rn = &junk;
int n = 0;
int *a = 0;
}

P0(int **a, int **rg, int **ro, int **rn, int *sel, int *n)
{
	WRITE_ONCE(*n, 1);		// build the new object
	WRITE_ONCE(*sel, 0);		// __rcu_txn_group_init()
	WRITE_ONCE(*ro, NULL);		// __rcu_txn_record_set()
	WRITE_ONCE(*rn, n);
	WRITE_ONCE(*rg, sel);		// __rcu_txn_record_install(): r->group,
	rcu_assign_pointer(*a, rg);	// then the proxy
	smp_store_release(sel, 1);	// __rcu_txn_group_commit()
	rcu_assign_pointer(*a, n);	// __rcu_txn_record_settle()
}

P1(int **a, int **rg, int **ro, int **rn)
{
	int *r0;
	int *r1;
	int r2;
	int *t;
	int d;

	rcu_read_lock();
	r0 = rcu_dereference(*a);
	if (r0 == rg) {
		r1 = READ_ONCE(*r0);
		r2 = smp_load_acquire(r1);
		if (r2) {
			t = READ_ONCE(*rn);
		} else {
			t = READ_ONCE(*ro);
		}
	} else {
		t = r0;
	}
	if (t)
		d = READ_ONCE(*t);
	rcu_read_unlock();
}

exists ((1:r0=rg /\ (1:r1=junk \/ 1:r2=2 \/ 1:t=junk)) \/ (1:t=n /\ 1:d=0))

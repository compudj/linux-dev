C RCU-txn+reuse+monotonic

(*
 * Result: Never
 *
 * A transaction runs on a descriptor that comes back from a pool.  An
 * earlier transaction left the selector at 1 and its own targets in the
 * records (x1).  rcu_txn_init_local() stores 0 to the selector again, with
 * a plain store (__rcu_txn_group_init()).  The writer then sets the
 * records, installs, flips and settles.  The install's store-release orders
 * the selector's 0 and the records before a reader that finds a proxy.  So
 * the reader never resolves through the stale 1, and never reads a stale
 * target.
 *
 * The transaction is the one of RCU-txn+monotonic+dep.  The slots hold no
 * proxy when the writer starts.  So no reader is within a resolve section
 * on the descriptor: see RCU-txn+steal+reuse for that.
 *
 * The reader checks slot b as in RCU-txn+steal+reuse.
 *)

{
int sel = 1;
int x1 = 0;
int aold = 0;
int bold = 0;
int bnew = 0;
int *b = &bold;
int *a = &aold;
int *rag = &sel;
int *rao = &x1;
int *ran = &x1;
int *rbg = &sel;
int *rbo = &x1;
int *rbn = &x1;
}

P0(int **a, int **b, int **rag, int **rao, int **ran, int **rbg,
   int **rbo, int **rbn, int *sel, int *aold, int *bold, int *bnew)
{
	WRITE_ONCE(*sel, 0);		// __rcu_txn_group_init()
	WRITE_ONCE(*rao, aold);		// __rcu_txn_record_set()
	WRITE_ONCE(*ran, b);
	WRITE_ONCE(*rbo, bold);
	WRITE_ONCE(*rbn, bnew);
	WRITE_ONCE(*rag, sel);		// install
	rcu_assign_pointer(*a, rag);
	WRITE_ONCE(*rbg, sel);
	rcu_assign_pointer(*b, rbg);
	smp_store_release(sel, 1);	// flip
	rcu_assign_pointer(*a, b);	// settle: a now points to b's node
	rcu_assign_pointer(*b, bnew);
}

P1(int **a, int **b, int **rag, int **rao, int **ran, int *x1,
   struct srcu_struct *s)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *ta;
	int *s0;
	int idx;

	rcu_read_lock();
	v = rcu_dereference(*a);
	if (v == rag) {
		idx = srcu_read_lock(s);	// enter the resolve section
		r0 = smp_load_acquire(a);	// load the slot again
		if (r0 == rag) {
			r1 = READ_ONCE(*r0);
			r2 = smp_load_acquire(r1);
			if (r2) {
				ta = READ_ONCE(*ran);
			} else {
				ta = READ_ONCE(*rao);
			}
		} else {
			ta = r0;
		}
		srcu_read_unlock(s, idx);	// leave it
	} else {
		ta = v;
	}
	if (ta == b) {
		s0 = rcu_dereference(*ta);	// slot b, not resolved
	}
	rcu_read_unlock();
}

exists ((1:ta=b /\ 1:s0=bold) \/ 1:ta=x1)

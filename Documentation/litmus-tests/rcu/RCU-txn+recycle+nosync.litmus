C RCU-txn+recycle+nosync

(*
 * Result: Sometimes
 *
 * The batch is marked done without a grace period after the settle.  The
 * owning CPU can then reuse the descriptor while a reader is still within
 * its resolve section.  The reader can read the record reused.
 *
 * Error injection into RCU-txn+recycle.  The rest is the same.
 *)

{
int junk = 9;
int sel = 0;
int o = 1;
int n = 1;
int *rg = &sel;
int *ro = &o;
int *rn = &n;
int *a = &rg;
int done = 0;
}

P0(int **a, int *sel, int *n, int *done)
{
	smp_store_release(sel, 1);	// flip
	rcu_assign_pointer(*a, n);	// settle, then call_rcu_hurry()
					// no grace period
	smp_store_release(done, 1);	// the batch is done
}

P1(int **a, int **rg, int **ro, int **rn, struct srcu_struct *s)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *t;
	int idx;

	rcu_read_lock();
	v = rcu_dereference(*a);
	if (v == rg) {
		idx = srcu_read_lock(s);	// enter the resolve section
		r0 = smp_load_acquire(a);	// load the slot again
		if (r0 == rg) {
			r1 = READ_ONCE(*r0);
			r2 = smp_load_acquire(r1);
			if (r2) {
				t = READ_ONCE(*rn);
			} else {
				t = READ_ONCE(*ro);
			}
		} else {
			t = r0;
		}
		srcu_read_unlock(s, idx);	// leave it
	} else {
		t = v;
	}
	rcu_read_unlock();
}

P2(int **rg, int **ro, int **rn, int *junk, int *done)
{
	int r0;

	r0 = smp_load_acquire(done);	// rcu_txn_local_reap()
	if (r0) {			// RCU_TXN_BATCH_DONE
		WRITE_ONCE(*rg, junk);	// reuse
		WRITE_ONCE(*ro, junk);
		WRITE_ONCE(*rn, junk);
	}
}

exists (1:r0=rg /\ (1:r1=junk \/ 1:t=junk))

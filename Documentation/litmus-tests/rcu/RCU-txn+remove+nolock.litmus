C RCU-txn+remove+nolock

(*
 * Result: Sometimes
 *
 * The reader has no RCU read-side critical section around the load of the
 * slot and the use of the object.  So the grace period does not wait for
 * the reader.  The reader can then read the object after it is freed.
 *
 * The record is still safe.  The reader only reads it within a resolve
 * section.  This section disables interrupts, so it is an RCU read-side
 * critical section of its own.  rcu_read_lock() stands for it here.  See
 * RCU-txn+sync+free+section.  So the outcome here is about the object
 * alone.
 *
 * Error injection into RCU-txn+remove.  The rest is the same.
 *)

{
int junk = 9;
int sel = 2;
int *rg = &junk;
int *ro = &junk;
int *rn = &junk;
int o = 1;
int *a = &o;
}

P0(int **a, int **rg, int **ro, int **rn, int *sel, int *o, int *junk)
{
	WRITE_ONCE(*sel, 0);		// __rcu_txn_group_init()
	WRITE_ONCE(*ro, o);		// __rcu_txn_record_set()
	WRITE_ONCE(*rn, NULL);
	WRITE_ONCE(*rg, sel);		// __rcu_txn_record_install(): r->group,
	rcu_assign_pointer(*a, rg);	// then the proxy
	smp_store_release(sel, 1);	// __rcu_txn_group_commit()
	rcu_assign_pointer(*a, NULL);	// __rcu_txn_record_settle()
	synchronize_rcu();		// both kfree_rcu()
	WRITE_ONCE(*o, 0);		// the allocator reuses the object
	WRITE_ONCE(*sel, 2);		// and the descriptor
	WRITE_ONCE(*rg, junk);
	WRITE_ONCE(*ro, junk);
	WRITE_ONCE(*rn, junk);
}

P1(int **a, int **rg, int **ro, int **rn, struct srcu_struct *s)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *t;
	int d;
	int idx;

	v = rcu_dereference(*a);
	if (v == rg) {
		rcu_read_lock();	// interrupts off
		idx = srcu_read_lock(s);	// enter the resolve section
		r0 = smp_load_acquire(a);	// load the slot again
		if (r0 == rg) {
			r1 = READ_ONCE(*r0);
			r2 = smp_load_acquire(r1);
			if (r2) {
				t = READ_ONCE(*rn);
			} else {
				t = READ_ONCE(*ro);
			}
		} else {
			t = r0;
		}
		srcu_read_unlock(s, idx);	// leave it
		rcu_read_unlock();
	} else {
		t = v;
	}
	if (t)
		d = READ_ONCE(*t);
}

exists (1:t=o /\ 1:d=0)

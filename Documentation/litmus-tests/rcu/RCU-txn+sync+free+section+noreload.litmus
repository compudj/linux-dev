C RCU-txn+sync+free+section+noreload

(*
 * Result: Sometimes
 *
 * The reader resolves the proxy it loaded before its resolve section.  It
 * does not load the slot again within it.  The grace period need not wait
 * for a section that begins after the settle.  So the reader can read the
 * record after it is freed.
 *
 * Error injection into RCU-txn+sync+free+section.  The rest is the same.
 *)

{
int junk = 9;
int sel = 0;
int o = 1;
int n = 1;
int *rg = &sel;
int *ro = &o;
int *rn = &n;
int *a = &rg;
}

P0(int **a, int **rg, int **ro, int **rn, int *sel, int *n, int *junk)
{
	smp_store_release(sel, 1);	// flip
	rcu_assign_pointer(*a, n);	// settle
	synchronize_rcu();		// kfree_rcu() of the descriptor
	WRITE_ONCE(*rg, junk);
	WRITE_ONCE(*ro, junk);
	WRITE_ONCE(*rn, junk);
}

P1(int **a, int **rg, int **ro, int **rn, struct srcu_struct *s)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *t;
	int idx;

	v = rcu_dereference(*a);
	if (v == rg) {
		rcu_read_lock();	// interrupts off
		idx = srcu_read_lock(s);	// enter the resolve section
		r0 = v;			// resolve the proxy loaded before
		if (r0 == rg) {
			r1 = READ_ONCE(*r0);
			r2 = smp_load_acquire(r1);
			if (r2) {
				t = READ_ONCE(*rn);
			} else {
				t = READ_ONCE(*ro);
			}
		} else {
			t = r0;
		}
		srcu_read_unlock(s, idx);	// leave it
		rcu_read_unlock();
	} else {
		t = v;
	}
}

exists (1:r0=rg /\ (1:r1=junk \/ 1:t=junk))

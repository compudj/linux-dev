C RCU-txn+monotonic+rmb

(*
 * Result: Never
 *
 * As RCU-txn+monotonic+dep, but the reader loads slot b independently of
 * slot a.  It orders its two loads with smp_rmb() between its two calls to
 * rcu_txn_dereference().
 *
 * The transaction, the records and what the reader leaves out are those of
 * RCU-txn+monotonic+dep.
 *)

{
int sel = 0;
int aold = 0;
int bold = 0;
int bnew = 0;
int *b = &bold;
int *a = &aold;
int *rag = &sel;
int *rao = &aold;
int *ran = &b;
int *rbg = &sel;
int *rbo = &bold;
int *rbn = &bnew;
}

P0(int **a, int **b, int **rag, int **rbg, int *sel, int *bnew)
{
	rcu_assign_pointer(*a, rag);	// install
	rcu_assign_pointer(*b, rbg);
	smp_store_release(sel, 1);	// flip
	rcu_assign_pointer(*a, b);	// settle: a now points to b's node
	rcu_assign_pointer(*b, bnew);
}

P1(int **a, int **b, int **rag, int **rao, int **ran,
   int **rbg, int **rbo, int **rbn)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *ta;
	int *s0;
	int *s1;
	int s2;
	int *tb;

	rcu_read_lock();
	v = rcu_dereference(*a);
	if (v == rag) {
		r0 = smp_load_acquire(a);
		if (r0 == rag) {
			r1 = READ_ONCE(*r0);
			r2 = smp_load_acquire(r1);
			if (r2) {
				ta = READ_ONCE(*ran);
			} else {
				ta = READ_ONCE(*rao);
			}
		} else {
			ta = r0;
		}
	} else {
		ta = v;
	}
	smp_rmb();
	if (ta == b) {
		s0 = rcu_dereference(*b);
		if (s0 == rbg) {
			s1 = READ_ONCE(*s0);
			s2 = smp_load_acquire(s1);
			if (s2) {
				tb = READ_ONCE(*rbn);
			} else {
				tb = READ_ONCE(*rbo);
			}
		} else {
			tb = s0;
		}
	}
	rcu_read_unlock();
}

exists (1:ta=b /\ 1:tb=bold)

C RCU-txn+list+step-back+once-settle

(*
 * Result: Sometimes
 *
 * The settle of P->next is a plain store.  A reader can find the new target
 * settled there.  It can then find N->prev still holding its old one.
 *
 * Error injection into RCU-txn+list+step-back.  The rest is the same.
 *)

{
int sel = 0;
int nodep = 0;
int noden = 0;
int *nprev = &nodep;
int *pnext = &noden;
int *rpg = &sel;
int *rpo = &noden;
int *rpn = &nprev;
int *rng = &sel;
int *rno = &nodep;
int *rnn = &nprev;
}

P0(int **pnext, int **nprev, int **rpg, int **rng, int *sel)
{
	rcu_assign_pointer(*pnext, rpg);	// install
	rcu_assign_pointer(*nprev, rng);
	smp_store_release(sel, 1);		// flip
	WRITE_ONCE(*pnext, nprev);		// settle, unordered
	rcu_assign_pointer(*nprev, nprev);	// N->prev = X
}

P1(int **pnext, int **nprev, int **rpg, int **rpo, int **rpn,
   int **rng, int **rno, int **rnn)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *t;
	int *s0;
	int *s1;
	int s2;
	int *back;

	rcu_read_lock();
	v = rcu_dereference(*pnext);	// forward from P
	if (v == rpg) {
		r0 = smp_load_acquire(pnext);
		if (r0 == rpg) {
			r1 = READ_ONCE(*r0);
			r2 = smp_load_acquire(r1);
			if (r2) {
				t = READ_ONCE(*rpn);
			} else {
				t = READ_ONCE(*rpo);
			}
		} else {
			t = r0;
		}
	} else {
		t = v;
	}
	if (t == nprev) {	// onto X, then onto N
		s0 = rcu_dereference(*t);	// back from N
		if (s0 == rng) {
			s1 = READ_ONCE(*s0);
			s2 = smp_load_acquire(s1);
			if (s2) {
				back = READ_ONCE(*rnn);
			} else {
				back = READ_ONCE(*rno);
			}
		} else {
			back = s0;
		}
	}
	rcu_read_unlock();
}

exists (1:t=nprev /\ 1:back=nodep)

C RCU-txn+recycle

(*
 * Result: Never
 *
 * A descriptor that is not stolen goes back to its CPU's pool a grace period
 * after its settle.  The callback that call_rcu() runs then may run on another
 * CPU, as with rcu_nocbs, and only marks the descriptor's batch done, with a
 * store-release.  The owning CPU loads the mark with a load-acquire, and only
 * then reuses the descriptor.  A reader within an RCU read-side critical
 * section, which resolves the proxy as in RCU-txn+steal, never reads the
 * record reused.  Its resolve section, interrupts off, is one too: herd7 has
 * no interrupts, and the outer rcu_read_lock() stands for both.
 *
 * call_rcu() is not in the model: the writer waits for the grace period
 * itself, then runs the callback.  P2 is the owning CPU, which finds the batch
 * done and stores junk into the record, as a new transaction may.  The outcome
 * is restricted to the executions where it found the batch done.
 *)

{
int junk = 9;
int sel = 0;
int o = 1;
int n = 1;
int *rg = &sel;
int *ro = &o;
int *rn = &n;
int *a = &rg;
int seq = 0;
int done = 0;
}

P0(int **a, int *sel, int *n, int *done)
{
	smp_store_release(sel, 1);	// flip
	rcu_assign_pointer(*a, n);	// settle, then call_rcu()
	synchronize_rcu();		// the callback runs
	smp_store_release(done, 1);	// the batch is done
}

P1(int **a, int **rg, int **ro, int **rn, int *seq)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *t;

	rcu_read_lock();
	v = rcu_dereference(*a);
	if (v == rg) {
		WRITE_ONCE(*seq, 1);		// enter the resolve section
		smp_mb();
		r0 = rcu_dereference(*a);	// load the slot again
		if (r0 == rg) {
			r1 = READ_ONCE(*r0);
			r2 = smp_load_acquire(r1);
			if (r2) {
				t = READ_ONCE(*rn);
			} else {
				t = READ_ONCE(*ro);
			}
		} else {
			t = r0;
		}
		smp_store_release(seq, 2);	// leave it
	}
	rcu_read_unlock();
}

P2(int **rg, int **ro, int **rn, int *junk, int *done)
{
	int r0;

	r0 = smp_load_acquire(done);	// rcu_txn_local_reap()
	WRITE_ONCE(*rg, junk);		// reuse
	WRITE_ONCE(*ro, junk);
	WRITE_ONCE(*rn, junk);
}

exists (2:r0=1 /\ 1:r0=rg /\ (1:r1=junk \/ 1:t=junk))

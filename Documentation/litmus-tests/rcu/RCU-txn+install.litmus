C RCU-txn+install

(*
 * Result: Never
 *
 * The install of a proxy publishes its record.  A reader that finds the
 * proxy in the slot reads the record's group, the selector's initial 0 and
 * the record's old target.  It never reads what was there before.
 *
 * The reader is rcu_txn_dereference().  It loads the slot and tests the
 * value.  For a proxy, it enters a resolve section and loads the slot
 * again, with a load-acquire.  It resolves what the slot holds then.  See
 * __rcu_txn_resolve_slow().  A resolve section is an atomic SRCU read-side
 * critical section with interrupts disabled.  herd7 has no interrupts, so
 * it is a plain SRCU one here.
 *
 * The record is modeled by three variables.  rg holds its group, which is
 * the address of the selector.  ro and rn hold its old and new targets.
 * When the slot holds the proxy, it holds the address of rg.  The reader's
 * tag test compares the loaded value with that address.  Before the writer
 * runs, each of these variables holds garbage: junk, or 2 for the selector.
 *
 * The model differs from the code in three ways:
 *
 *  - The code indexes the record's targets with the selector.  This is an
 *    address dependency.  herd7 has no arrays, so the reader branches on
 *    the selector instead.  A branch orders no later load.
 *  - The code loads the targets through the proxy.  Here ro and rn have
 *    fixed addresses.  The selector's load-acquire orders these loads
 *    instead.
 *  - The code sets the selector and the record with plain stores.  They
 *    are WRITE_ONCE() here.  The targets are loaded with READ_ONCE(), as
 *    in the code.  With plain accesses, herd7 still never finds this
 *    outcome, and flags no data race.  But it then flags a data race in
 *    the error-injection variants, which hides the outcome they show.
 *
 * In the first two, the model orders less than the code.  An outcome that
 * the model forbids, the code forbids as well.
 *)

{
int junk = 9;
int sel = 2;
int *rg = &junk;
int *ro = &junk;
int *rn = &junk;
int o = 1;
int n = 1;
int *a = &o;
}

P0(int **a, int **rg, int **ro, int **rn, int *sel, int *o, int *n)
{
	WRITE_ONCE(*sel, 0);		// __rcu_txn_group_init()
	WRITE_ONCE(*ro, o);		// __rcu_txn_record_set()
	WRITE_ONCE(*rn, n);
	WRITE_ONCE(*rg, sel);		// __rcu_txn_record_install(): r->group,
	rcu_assign_pointer(*a, rg);	// then the proxy
}

P1(int **a, int **rg, int **ro, int **rn, struct srcu_struct *s)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *t;
	int idx;

	rcu_read_lock();
	v = rcu_dereference(*a);
	if (v == rg) {			// a proxy
		idx = srcu_read_lock(s);	// enter the resolve section
		r0 = smp_load_acquire(a);	// load the slot again
		if (r0 == rg) {
			r1 = READ_ONCE(*r0);	// proxy->group
			r2 = smp_load_acquire(r1);	// group->selector
			if (r2) {
				t = READ_ONCE(*rn);	// proxy->ptr[1]
			} else {
				t = READ_ONCE(*ro);	// proxy->ptr[0]
			}
		} else {
			t = r0;
		}
		srcu_read_unlock(s, idx);	// leave it
	} else {
		t = v;
	}
	rcu_read_unlock();
}

exists (1:r0=rg /\ (1:r1=junk \/ 1:r2=2 \/ 1:t=junk))

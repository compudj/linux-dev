C RCU-txn+steal

(*
 * Result: Never
 *
 * A descriptor may be stolen back before its grace period ends, when its
 * CPU's pool runs out.  See the local transactions of lib/rcu_txn.c.  A
 * reader that finds a proxy resolves it within a resolve section, as
 * __rcu_txn_resolve_slow() does.  This is an atomic SRCU read-side critical
 * section.  Within it, the reader loads the slot again and resolves what
 * the slot now holds.  After the settle, the steal waits for the sections
 * in flight.  It calls __rcu_txn_synchronize_resolve(), which uses
 * synchronize_srcu_atomic().  So the reader never reads the stolen record,
 * which a new transaction may then reuse.
 *
 * The record is rg, ro and rn (see RCU-txn+install).  After the steal, the
 * writer stores junk into the record, as a new transaction may.  See
 * RCU-txn+steal+reuse for a whole second transaction.
 *
 * herd7 models synchronize_srcu_atomic() as synchronize_srcu().  Both wait
 * for the same readers.  The first spins and the second sleeps.  herd7 has
 * no interrupts either, so a resolve section does not disable them here.
 *)

{
int junk = 9;
int sel = 0;
int o = 1;
int n = 1;
int *rg = &sel;
int *ro = &o;
int *rn = &n;
int *a = &rg;
}

P0(int **a, int **rg, int **ro, int **rn, int *sel, int *n, int *junk,
   struct srcu_struct *s)
{
	smp_store_release(sel, 1);	// flip
	rcu_assign_pointer(*a, n);	// settle, then retire to the pool
	synchronize_srcu(s);		// __rcu_txn_synchronize_resolve()
	WRITE_ONCE(*rg, junk);		// reuse
	WRITE_ONCE(*ro, junk);
	WRITE_ONCE(*rn, junk);
}

P1(int **a, int **rg, int **ro, int **rn, struct srcu_struct *s)
{
	int *v;
	int *r0;
	int *r1;
	int r2;
	int *t;
	int idx;

	rcu_read_lock();
	v = rcu_dereference(*a);
	if (v == rg) {
		idx = srcu_read_lock(s);	// enter the resolve section
		r0 = smp_load_acquire(a);	// load the slot again
		if (r0 == rg) {
			r1 = READ_ONCE(*r0);
			r2 = smp_load_acquire(r1);
			if (r2) {
				t = READ_ONCE(*rn);
			} else {
				t = READ_ONCE(*ro);
			}
		} else {
			t = r0;
		}
		srcu_read_unlock(s, idx);	// leave it
	} else {
		t = v;
	}
	rcu_read_unlock();
}

exists (1:r0=rg /\ (1:r1=junk \/ 1:t=junk))
